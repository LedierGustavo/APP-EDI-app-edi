{
  "name": "app-edi",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "APP EDI - Teste de API Braspress",
  "author": "APP EDI",
  "repository": {
    "type": "git",
    "url": "https://github.com/LedierGustavo/APP-EDI-app-edi.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && electron .",
    "build": "tsc -b && vite build",
    "build:electron": "powershell -Command \"npx tsc -p tsconfig.electron.json; if (Test-Path dist-electron/main.js) { Move-Item -Path dist-electron/main.js -Destination dist-electron/main.cjs -Force }; if (Test-Path dist-electron/preload.js) { Move-Item -Path dist-electron/preload.js -Destination dist-electron/preload.cjs -Force }\" && vite build",
    "dist": "npm run build:electron && electron-builder --win --publish never",
    "release": "npm run build:electron && electron-builder --win --publish always",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "electron-builder"
  },
  "build": {
    "appId": "com.appedi.desktop",
    "productName": "APP EDI",
    "directories": {
      "output": "C:/Users/ledie/AppData/Local/Temp/opencode/app-edi-release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "LedierGustavo",
      "repo": "APP-EDI-app-edi",
      "private": false,
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "fernet": "^0.3.3",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
